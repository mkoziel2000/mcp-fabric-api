# Transport mode: "stdio" (default) or "http"
TRANSPORT=stdio

# HTTP mode settings
PORT=3000

# Authentication method (stdio mode):
#   "default"             - DefaultAzureCredential chain; works on Windows with 'az login'
#   "device-code"         - Prints a URL + code to stderr; authenticate in browser (best for Mac / Claude Desktop)
#   "client-secret"       - Service principal auth (headless / automated scenarios)
#   "interactive-browser" - Opens browser for OAuth (requires browser access from the process)
AUTH_METHOD=default

# Required for HTTP mode OAuth2, client-secret, and device-code methods
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# Required for HTTP mode OAuth2 and client-secret method only
AZURE_CLIENT_SECRET=
